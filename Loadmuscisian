-- REAL-PLAYER ESP RENDERER (Drawing API)
----------------------------------------------------------------
local hasDrawing = type(Drawing) ~= "nil"
local espDraw = {}
local ESP_BLACK = Color3.new(0, 0, 0)
local function mkDraw(class, props)
	local o = Drawing.new(class)
	for k, v in pairs(props) do pcall(function() o[k] = v end) end
	return o
end
local function espGet(p)
	local e = espDraw[p]
	if not e and hasDrawing then
		e = {
			boxOut = mkDraw("Square", { Thickness = 3, Filled = false, Color = ESP_BLACK, Visible = false, ZIndex = 1 }),
			box    = mkDraw("Square", { Thickness = 1, Filled = false, Color = WHITE, Visible = false, ZIndex = 2 }),
			hpBack = mkDraw("Square", { Thickness = 1, Filled = true, Color = ESP_BLACK, Visible = false, ZIndex = 1 }),
			hpFill = mkDraw("Square", { Thickness = 1, Filled = true, Color = WHITE, Visible = false, ZIndex = 2 }),
			lineOut = mkDraw("Line", { Thickness = 3, Color = ESP_BLACK, Visible = false, ZIndex = 1 }),
			line    = mkDraw("Line", { Thickness = 1, Color = WHITE, Visible = false, ZIndex = 2 }),
			dotOut  = mkDraw("Circle", { Thickness = 1, NumSides = 16, Radius = 4, Filled = true, Color = ESP_BLACK, Visible = false, ZIndex = 1 }),
			dot     = mkDraw("Circle", { Thickness = 1, NumSides = 16, Radius = 3, Filled = true, Color = WHITE, Visible = false, ZIndex = 2 }),
			nameT   = mkDraw("Text", { Size = 13, Center = true, Outline = true, Font = 2, Color = WHITE, Visible = false, ZIndex = 3 }),
			distT   = mkDraw("Text", { Size = 13, Center = true, Outline = true, Font = 2, Color = WHITE, Visible = false, ZIndex = 3 }),
			weaponT = mkDraw("Text", { Size = 13, Center = true, Outline = true, Font = 2, Color = WHITE, Visible = false, ZIndex = 3 }),
		}
		espDraw[p] = e
	end
	return e
end
local function espHide(p)
	local e = espDraw[p]
	if e then for _, o in pairs(e) do o.Visible = false end end
end
local function edgePointScreen(cam, worldPos, vs)
	local rel = cam.CFrame:PointToObjectSpace(worldPos)
	local dir = Vector2.new(rel.X, -rel.Y)
	if dir.Magnitude < 1e-3 then dir = Vector2.new(0, 1) end
	dir = dir.Unit
	local half = Vector2.new(vs.X / 2 - 20, vs.Y / 2 - 20)
	local sx = dir.X ~= 0 and half.X / math.abs(dir.X) or math.huge
	local sy = dir.Y ~= 0 and half.Y / math.abs(dir.Y) or math.huge
	return Vector2.new(vs.X / 2, vs.Y / 2) + dir * math.min(sx, sy)
end
local function espUpdate(p)
	if not hasDrawing then return end
	local char = p.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
	local cam  = workspace.CurrentCamera
	if not (root and hum and hum.Health > 0 and cam) then espHide(p) return end
	if not plAllowed(p, "esp") then espHide(p) return end

	local e = espGet(p)
	if not e then return end
	local vs = cam.ViewportSize

	local head = char:FindFirstChild("Head")
	local rootPos = root.Position
	local topWorld = head and (head.Position + Vector3.new(0, head.Size.Y / 2 + 0.1, 0)) or (rootPos + Vector3.new(0, 2.8, 0))
	local botWorld = rootPos - Vector3.new(0, math.max(hum.HipHeight + 1, 3), 0)

	local pos, onScreen = cam:WorldToViewportPoint(rootPos)
	if not (onScreen and pos.Z > 0) then espHide(p) return end

	local top = cam:WorldToViewportPoint(topWorld)
	local bot = cam:WorldToViewportPoint(botWorld)
	local h = math.max(math.abs(bot.Y - top.Y), 4)
	local w = h * 0.55
	local x = math.floor(pos.X - w / 2)
	local y = math.floor(math.min(top.Y, bot.Y))
	local fh, fw = math.floor(h), math.floor(w)

	if ESP.box then
		local at, size = Vector2.new(x, y), Vector2.new(fw, fh)
		e.boxOut.Position, e.boxOut.Size = at, size
		e.box.Position, e.box.Size = at, size
		e.box.Color = ESP.boxColor
		e.boxOut.Visible, e.box.Visible = true, true
	else
		e.boxOut.Visible, e.box.Visible = false, false
	end

	if ESP.health then
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		local hx = x - 7
		local barH = math.max(math.floor(fh * frac), 1)
		e.hpBack.Position, e.hpBack.Size = Vector2.new(hx, y - 1), Vector2.new(5, fh + 2)
		e.hpFill.Position, e.hpFill.Size = Vector2.new(hx + 1, y + fh - barH), Vector2.new(3, barH)
		e.hpFill.Color = ESP.healthLow:Lerp(ESP.healthHigh, frac)
		e.hpBack.Visible, e.hpFill.Visible = true, true
	else
		e.hpBack.Visible, e.hpFill.Visible = false, false
	end

	local cx = x + fw / 2
	if ESP.name then
		e.nameT.Text = p.DisplayName
		e.nameT.Color = ESP.nameColor
		local th = e.nameT.TextBounds.Y
		if th == 0 then th = 13 end
		e.nameT.Position = Vector2.new(cx, y - th - 3)
		e.nameT.Visible = true
	else
		e.nameT.Visible = false
	end

	local below = y + fh + 3
	if ESP.dist then
		e.distT.Text = "[" .. math.floor((rootPos - cam.CFrame.Position).Magnitude) .. "m]"
		e.distT.Color = ESP.distColor
		e.distT.Position = Vector2.new(cx, below)
		e.distT.Visible = true
		below += 16
	else
		e.distT.Visible = false
	end
	if ESP.weapon then
		local tool = char:FindFirstChildOfClass("Tool")
		e.weaponT.Text = tool and (tool.Name:gsub("[%[%]]", "")) or "none"
		e.weaponT.Color = ESP.weaponColor
		e.weaponT.Position = Vector2.new(cx, below)
		e.weaponT.Visible = true
	else
		e.weaponT.Visible = false
	end

	local showTr = false
	if ESP.tracer then
		local o = ESP.tracerOrigin
		local from
		if o == "Mouse" then from = UIS:GetMouseLocation()
		elseif o == "Top" then from = Vector2.new(vs.X / 2, 0)
		elseif o == "Center" then from = Vector2.new(vs.X / 2, vs.Y / 2)
		else from = Vector2.new(vs.X / 2, vs.Y) end

		local mode = ESP.tracerTarget
		local tw = (mode == "Head") and topWorld or ((mode == "Torso") and rootPos or botWorld)
		local tp, tOn = cam:WorldToViewportPoint(tw)
		local to
		if tOn and tp.Z > 0 then to = Vector2.new(tp.X, tp.Y) else to = edgePointScreen(cam, tw, vs) end

		if (to - from).Magnitude > 2 then
			showTr = true
			local col, th3 = ESP.tracerColor, ESP.tracerThick
			e.lineOut.From, e.lineOut.To, e.lineOut.Thickness = from, to, th3 + 2
			e.line.From, e.line.To, e.line.Thickness, e.line.Color = from, to, th3, col
			e.dotOut.Position, e.dotOut.Radius = to, 3 + th3
			e.dot.Position, e.dot.Radius, e.dot.Color = to, 2 + th3, col
		end
	end
	e.lineOut.Visible, e.line.Visible = showTr, showTr
	e.dotOut.Visible, e.dot.Visible = showTr, showTr
end
-- Drawing objects are created up front (creating ~11 per player on the first enable was a hitch),
-- and the per-frame hide loop only runs once when ESP turns off instead of every frame.
for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LP then pcall(espGet, p) end
end
connect(Players.PlayerAdded, function(p) pcall(espGet, p) end)
local espWasOn = false
connect(RunService.RenderStepped, function()
	if not EspBind:IsActive() then
		if espWasOn then
			espWasOn = false
			for p in pairs(espDraw) do espHide(p) end
		end
		return
	end
	espWasOn = true
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then espUpdate(p) end
	end
end)
connect(Players.PlayerRemoving, function(p)
	local e = espDraw[p]
	if e then
		for _, o in pairs(e) do pcall(function() o:Remove() end) end
		espDraw[p] = nil
	end
end)

