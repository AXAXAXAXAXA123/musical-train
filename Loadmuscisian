-- Reads your inventory for a Stim (tool name contains "Stim", same match curzs V3 uses). No
-- teleporting: if you don't own one, nothing happens. Equips it, uses it, then puts back the
-- tool you were holding.
local AutoStim = { on = false, thr = 50, busy = false, cool = 0 }
local function findStim()
	for _, holder in ipairs({ LP.Character, LP:FindFirstChildOfClass("Backpack") }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t.Name:find("Stim", 1, true) then return t end
			end
		end
	end
	return nil
end
local function autoStimTick()
	if not AutoStim.on or AutoStim.busy or os.clock() < AutoStim.cool then return end
	local ch = LP.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	if hum.Health / math.max(hum.MaxHealth, 1) * 100 >= AutoStim.thr then return end
	local stim = findStim()
	if not stim then return end
	AutoStim.busy = true
	task.spawn(function()
		pcall(function()
			local prev = ch:FindFirstChildOfClass("Tool")
			if prev == stim then prev = nil end
			if stim.Parent ~= ch then hum:EquipTool(stim) end
			local t0 = os.clock()
			while stim.Parent ~= ch and os.clock() - t0 < 0.3 do RunService.Heartbeat:Wait() end
			if stim.Parent == ch then
				stim:Activate()
				stim:Activate()
			end
			if prev then
				task.wait(0.2)
				local bp = LP:FindFirstChildOfClass("Backpack")
				if alive and prev.Parent == bp and hum.Health > 0 then hum:EquipTool(prev) end
			end
		end)
		AutoStim.cool = os.clock() + 0.3
		AutoStim.busy = false
	end)
end
connect(RunService.Stepped, autoStimTick)
connect(RunService.Heartbeat, autoStimTick)

