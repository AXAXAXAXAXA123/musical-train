-- Shows `builder`'s controls only while every dependency holds. A dependency is a toggle id
-- (must be on) or { id, false } (must be off). Uses LinoriaLib's dependency boxes; if this
-- Linoria build doesn't have them the controls are simply always shown.
local function dependsOn(groupbox, deps, builder)
	if type(groupbox.AddDependencyBox) ~= "function" then
		builder(groupbox)
		return
	end
	local box = groupbox:AddDependencyBox()
	builder(box)
	local list = {}
	for _, d in ipairs(deps) do
		if type(d) == "table" then
			list[#list + 1] = { Toggles[d[1]], d[2] }
		else
			list[#list + 1] = { Toggles[d], true }
		end
	end
	box:SetupDependencies(list)
end

-- When a parent toggle goes off its child toggles go off too (they're hidden by then, and they
-- must not stay "on" behind the scenes).
local function clearChildren(...)
	for _, id in ipairs({ ... }) do
		local tg = Toggles[id]
		if tg and tg.Value then pcall(function() tg:SetValue(false) end) end
	end
end

-- Target velocity measured from how the target's position actually changes. Reading
-- AssemblyLinearVelocity is unreliable: anti-lock/desync spoofs it, which is what broke
-- prediction. Samples only count when the position really moved, so network update cadence
-- doesn't make it jitter.
local velTrack = setmetatable({}, { __mode = "k" })
local function measuredVel(p, root)
	local now = os.clock()
	local pos = root.Position
	local s = velTrack[p]
	if not s then
		velTrack[p] = { pos = pos, t = now, vel = Vector3.zero }
		return Vector3.zero
	end
	if (pos - s.pos).Magnitude > 0.001 then
		local el = now - s.t
		if el > 0.004 then
			local inst = (pos - s.pos) / el
			if inst.Magnitude < 300 then s.vel = s.vel:Lerp(inst, 0.6) else s.vel = Vector3.zero end
			s.pos, s.t = pos, now
		end
	elseif now - s.t > 0.2 then
		s.vel = s.vel * 0.8
	end
	return s.vel
end

-- Player List state. Settings are keyed by UserId so they survive switching players and a
-- player leaving/rejoining. Features: aim, trig, silent, esp, view (aimview).
--  * Blacklist : "only go after them". For a feature, once any blacklisted player is in the
--                server, that feature ONLY works on blacklisted players. "Applies to" picks the
--                features; with nothing ticked, every feature applies.
--  * Whitelist : "never touch them". Whitelisted players are skipped by the ticked features
--                (all of them start ticked when you turn it on).
-- A player can't be both. plAllowed(p, feature) is what every feature asks.
local PL_FEATURES = {
	{ key = "aim", text = "Aimbot" }, { key = "trig", text = "Triggerbot" },
	{ key = "silent", text = "Silent Aim" }, { key = "esp", text = "ESP" }, { key = "view", text = "Aimview" },
}
local PL = { cfg = {}, bl = { aim = 0, trig = 0, silent = 0, esp = 0, view = 0 }, selected = nil,
	perm = { white = {}, black = {} }, permInfo = {} } -- perm lists: UserId -> true, saved to a file
local function plCfg(uid)
	local c = PL.cfg[uid]
	if not c then
		c = { black = false, white = false, view = false, bl = {}, wl = {}, blAny = false }
		PL.cfg[uid] = c
	end
	return c
end
-- Counts, per feature, how many blacklisted players currently in the server apply to it. Only
-- players actually in the server count, so someone who left can't leave a feature stuck on nobody.
local function plRecount()
	for _, f in ipairs(PL_FEATURES) do PL.bl[f.key] = 0 end
	for uid, c in pairs(PL.cfg) do
		if c.black then
			local pl = Players:GetPlayerByUserId(uid)
			if pl and pl.Parent == Players then
				for _, f in ipairs(PL_FEATURES) do
					if c.bl[f.key] or not c.blAny then PL.bl[f.key] += 1 end
				end
			end
		end
	end
	for uid in pairs(PL.perm.black) do -- perm blacklist = blacklisted for every feature
		local pl = Players:GetPlayerByUserId(uid)
		if pl and pl.Parent == Players then
			for _, f in ipairs(PL_FEATURES) do PL.bl[f.key] += 1 end
		end
	end
end
local function plAllowed(p, feat)
	local uid = p.UserId
	if PL.perm.white[uid] then return false end -- perm whitelist: skipped by everything
	local c = PL.cfg[uid]
	if c and c.white and c.wl[feat] then return false end
	if PL.bl[feat] > 0 then
		if PL.perm.black[uid] then return true end
		return c ~= nil and c.black == true and (c.bl[feat] == true or not c.blAny)
	end
	return true
end

-- Perm lists: saved to Aureus/permlist.json (when the executor has file access) and applied by
-- UserId, so they work even before the player joins.
local PERM_FILE = "Aureus/permlist.json"
local function permSave()
	pcall(function()
		if not (writefile and isfolder and makefolder) then return end
		if not isfolder("Aureus") then makefolder("Aureus") end
		local out = { white = {}, black = {} }
		for kind in pairs(out) do
			for uid in pairs(PL.perm[kind]) do
				local i = PL.permInfo[uid] or {}
				out[kind][#out[kind] + 1] = { id = uid, name = i.name, display = i.display }
			end
		end
		writefile(PERM_FILE, game:GetService("HttpService"):JSONEncode(out))
	end)
end
local function permLoad()
	pcall(function()
		if not (readfile and isfile and isfile(PERM_FILE)) then return end
		local data = game:GetService("HttpService"):JSONDecode(readfile(PERM_FILE))
		for _, kind in ipairs({ "white", "black" }) do
			for _, e in ipairs(data[kind] or {}) do
				if type(e.id) == "number" then
					PL.perm[kind][e.id] = true
					if e.name then PL.permInfo[e.id] = { name = e.name, display = e.display or e.name } end
				end
			end
		end
	end)
end
-- Adding to one list removes the player from the other.
local function permAdd(kind, uid, name, display)
	PL.perm[kind == "white" and "black" or "white"][uid] = nil
	PL.perm[kind][uid] = true
	PL.permInfo[uid] = { name = name, display = display }
	permSave()
	plRecount()
	if PL.permChanged then PL.permChanged() end
end
local function permRemove(kind, uid)
	PL.perm[kind][uid] = nil
	permSave()
	plRecount()
	if PL.permChanged then PL.permChanged() end
end
