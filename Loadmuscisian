-- Aureus theme: gold accent on an obsidian panel, white text. ThemeManager owns its own color
-- pickers and re-applies its default theme (blue) after this script sets Library colors, so the
-- palette is pushed through those pickers too, and applied again after boot.
local function applyAureusTheme()
	pcall(function()
		local palette = {
			AccentColor = GOLD, MainColor = PANEL, BackgroundColor = OBSIDIAN,
			OutlineColor = BRONZE, FontColor = WHITE,
		}
		for name, col in pairs(palette) do
			local o = Options[name]
			if o and o.SetValueRGB then pcall(function() o:SetValueRGB(col) end) end
			Library[name] = col
		end
		Library.AccentColorDark = Library:GetDarkerColor(GOLD)
		Library:UpdateColorsUsingRegistry()
	end)
end

----------------------------------------------------------------
-- BOOT SEQUENCE
----------------------------------------------------------------
-- Linoria doesn't fire callbacks for defaults at creation, so every value gets pushed into the
-- script state once here. :SetValue() runs the callback AND the element's own redraw (the old
-- t.Callback(t.Value) route skipped the redraw). KeyPickers (SetValue = rebind) and ColorPickers
-- (SetValue expects an HSV table, not a Color3) are skipped.
for _, t in pairs(Toggles) do
	pcall(function() t:SetValue(t.Value) end)
end
for _, o in pairs(Options) do
	if o.Type ~= "KeyPicker" and o.Type ~= "ColorPicker" and o.SetValue then
		pcall(function() o:SetValue(o.Value) end)
	end
end

pcall(function() SaveManager:LoadAutoloadConfig() end)
applyAureusTheme()
task.delay(0.6, function() if alive then applyAureusTheme() end end)

----------------------------------------------------------------
-- TITLE LETTER-FADE (gold <-> cream <-> gold, one gradient across the whole label so every
-- letter is always in sync with the ones next to it)
----------------------------------------------------------------
do
	local function findTitleLabel()
		-- Built with table.insert: a nil first entry in a { ... } literal would make ipairs stop
		-- before reaching anything (Library.Gui is nil in LinoriaLib, which is why the fade never ran).
		local roots = {}
		if Library.ScreenGui then table.insert(roots, Library.ScreenGui) end
		if Library.Gui then table.insert(roots, Library.Gui) end
		if type(gethui) == "function" then
			local ok, h = pcall(gethui)
			if ok and h then table.insert(roots, h) end
		end
		table.insert(roots, PlayerGui)
		pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
		for _, root in ipairs(roots) do
			local ok, label = pcall(function()
				for _, inst in ipairs(root:GetDescendants()) do
					if inst:IsA("TextLabel") and inst.Text == WINDOW_TITLE then return inst end
				end
			end)
			if ok and label then return label end
		end
		return nil
	end
	task.spawn(function()
		local label
		for _ = 1, 6 do
			task.wait(0.5) -- LinoriaLib needs a moment to finish building the window
			if not alive then return end
			label = findTitleLabel()
			if label then break end
		end
		if not label then return end -- best-effort: no title instance found
		local grad = Instance.new("UIGradient")
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, GOLD),
			ColorSequenceKeypoint.new(0.5, CREAM),
			ColorSequenceKeypoint.new(1, GOLD),
		})
		grad.Parent = label
		connect(RunService.RenderStepped, function()
			grad.Offset = Vector2.new(((os.clock() * 0.2) % 2) - 1, 0)
		end)
	end)
end

