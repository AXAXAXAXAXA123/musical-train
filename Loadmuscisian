local wallLostAt, wallLastLook = nil, nil
-- Velocity Delay. On a movement event the pull on that axis dips and eases back up over the delay
-- (shaped by the aimbot's easing style). The dip is moderate, so it still feels locked on, and it
-- is humanized: every event gets its own random duration/dip, the pull wobbles a little while it
-- recovers, and horizontal tracking recovers faster than vertical (people track sideways easier).
--  * vertical events (always): jump start, fall start, apex turn.
--  * horizontal events (unless "Only Air Velocity"): they start running, stop, or turn.
-- It only ever scales the pull down, so it can't fight your mouse. It also keeps a delayed copy of
-- the target's velocity (vd.vel) that Prediction uses, so the lead follows the same delay.
local vd = { tgt = nil, ySign = 0, yStart = nil, hStart = nil, href = Vector3.zero, hLast = 0,
	yVar = 1, hVar = 1, seed = math.random() * 100, vel = nil }
local function vdRamp(start, now, D, g0, var, seed)
	if not start then return 1, false end
	local u = (now - start) / (D * var)
	if u >= 1 then return 1, false end
	local gv = math.clamp(g0 / var, 0.05, 0.9)
	local pr = (easedProgress(u) * (u * u * (3 - 2 * u))) ^ (1 + Aim.veldelay / 600)
	local g = gv + (1 - gv) * pr
	g = math.clamp(g * (1 + 0.1 * math.noise(now * 2.7, seed, 0)), 0.05, 1)
	return g, true
end
local function vdUpdate(target, mvel, dt)
	local now = os.clock()
	local vy = mvel.Y
	local hv = Vector3.new(mvel.X, 0, mvel.Z)
	vdGain, vdGainH, vdActive = 1, 1, false
	if Aim.veldelay <= 0 then
		vd.tgt, vd.vel = nil, mvel
		return
	end
	if vd.tgt ~= target then
		vd.tgt, vd.yStart, vd.hStart, vd.vel = target, nil, nil, mvel
		vd.ySign = vy > 3 and 1 or (vy < -3 and -1 or 0)
		vd.href, vd.hLast = hv, 0
	end
	-- vertical events
	local ns = vd.ySign
	if vy > 3 then ns = 1 elseif vy < -3 then ns = -1 elseif math.abs(vy) < 1.2 then ns = 0 end
	if ns ~= vd.ySign then
		vd.ySign = ns
		vd.yStart = ns ~= 0 and now or nil -- jump / fall / apex turn starts it, landing ends it
		vd.yVar = 0.85 + math.random() * 0.3
	end
	-- horizontal events
	if Aim.airOnly then
		vd.hStart, vd.href = nil, hv
	elseif (hv - vd.href).Magnitude > 5 and now - vd.hLast > 0.1 then
		vd.hStart, vd.hLast, vd.href = now, now, hv
		vd.hVar = 0.85 + math.random() * 0.3
	else
		vd.href = vd.href:Lerp(hv, 1 - math.exp(-dt * 3))
	end
	local D = Aim.veldelay / 1000 * 3.5 -- 300 = about a second to fully catch up
	local g0 = 0.6 - 0.45 * (Aim.veldelay / 300) -- how far the pull dips: 0.52 at 50ms, 0.15 at 300ms
	local gY, aY = vdRamp(vd.yStart, now, D, g0, vd.yVar, vd.seed)
	if vd.yStart and not aY then vd.yStart = nil end
	local gH, aH = vdRamp(vd.hStart, now, D, g0, vd.hVar, vd.seed + 17)
	if vd.hStart and not aH then vd.hStart = nil end
	gH = gH ^ 0.75
	vdGain, vdGainH, vdActive = gY, gH, aY or aH
	-- delayed velocity for prediction: follows the real one at the same (reduced) pace
	local pv = vd.vel or mvel
	local rH, rY = 1 - math.exp(-dt * 14 * gH), 1 - math.exp(-dt * 14 * gY)
	vd.vel = Vector3.new(pv.X + (mvel.X - pv.X) * rH, pv.Y + (mvel.Y - pv.Y) * rY, pv.Z + (mvel.Z - pv.Z) * rH)
end

connect(RunService.RenderStepped, function(dt)
	local on = AimBind:IsActive()
	if not on then
		aimActive, lockedTarget = false, nil
		resetAssist()
		wallLostAt, wallLastLook, vd.tgt, stick.tgt = nil, nil, nil, nil
		return
	end
	if not aimActive then
		lockedTarget = aimAcquire()
		aimActive = lockedTarget ~= nil
		if not aimActive then resetAssist() return end
	end
	if lockedTarget and not aimCanAcquire(lockedTarget) then lockedTarget = nil end
	if lockedTarget and not lockedTarget.Character then return end
	if not lockedTarget then
		aimActive = false
		resetAssist()
		wallLostAt, wallLastLook, vd.tgt, stick.tgt = nil, nil, nil, nil
		return
	end

	local cam = workspace.CurrentCamera
	local char = lockedTarget.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (cam and root) then return end

	if Aim.wall then
		if aimVisible(lockedTarget) then
			wallLostAt = nil
		elseif Aim.instantwall then
			-- Instant Wall check: the ray to the target hit something that isn't them -> drop now.
			aimActive, lockedTarget = false, nil
			resetAssist()
			wallLostAt = nil
			return
		else
			-- Wall check: no pulling while hidden; let go once the delay has passed.
			wallLostAt = wallLostAt or os.clock()
			if os.clock() - wallLostAt >= Aim.walldelay / 1000 then
				aimActive, lockedTarget = false, nil
				resetAssist()
				wallLostAt = nil
			end
			return
		end
	else
		wallLostAt = nil
	end

	local part = pickAimPart(char, Aim.part, cam, lockedTarget) or root
	local aimPos = part.Position
	-- Velocity is measured from position change (AssemblyLinearVelocity gets spoofed by anti-lock,
	-- which is what threw prediction off, Blatant mode most of all).
	local mvel = measuredVel(lockedTarget, root)
	-- Velocity Delay first (legit only): sets the pull gains and the delayed velocity.
	if Aim.veldelayOn and Aim.aimmode ~= "Blatant" then
		vdUpdate(lockedTarget, mvel, dt)
	else
		vdGain, vdGainH, vdActive, vd.tgt, vd.yStart, vd.hStart, vd.vel = 1, 1, false, nil, nil, nil, nil
	end
	-- Prediction uses the delayed velocity while Velocity Delay is on, so the lead eases with the
	-- same delay instead of snapping, and still applies during it.
	local pvel = vd.vel or mvel
	if Aim.pred > 0 and not Aim.resolver then
		local comp = 1
		if Aim.aimmode ~= "Blatant" then
			comp = 1 + 2 * math.clamp((Aim.smooth - 60) / 40, 0, 1) ^ 2 -- keeps the lead effective at very high smoothness
		end
		aimPos += pvel * Aim.pred * comp
	end
	if Aim.aimmode ~= "Blatant" and Aim.jitter > 0 then
		local j = Aim.jitter
		aimPos += Vector3.new((math.random() - 0.5) * j, (math.random() - 0.5) * j, (math.random() - 0.5) * j)
	end

	local cf = cam.CFrame
	if Aim.method == "Mouse" then
		mouseAssist(cam, cf, aimPos, dt, lockedTarget)
		return
	end
	local look = nextLook(cf, aimPos, dt, lockedTarget)
	if look and look.Magnitude > 1e-4 then
		cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + look.Unit)
	elseif look then
		cam.CFrame = CFrame.lookAt(cf.Position, aimPos)
	end
end)

