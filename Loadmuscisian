local ArmorResp = false
local armorBusy = false
local function armorValue()
	local ch = LP.Character
	local be = ch and ch:FindFirstChild("BodyEffects")
	local a = be and be:FindFirstChild("Armor")
	return a and tonumber(a.Value)
end
local function maxArmor()
	local m = RS:FindFirstChild("MaxArmor")
	return m and m.Value or 200
end
local function findShopItem(pattern, near)
	local ig = workspace:FindFirstChild("Ignored")
	local shop = ig and ig:FindFirstChild("Shop")
	local best, bd = nil, nil
	if shop then
		for _, m in ipairs(shop:GetChildren()) do
			if m.Name:find(pattern, 1, true) then
				local d = (m:GetPivot().Position - near).Magnitude
				if not bd or d < bd then best, bd = m, d end
			end
		end
	end
	if not best then return nil end
	local det = best:FindFirstChildWhichIsA("ClickDetector", true)
	local head = best:FindFirstChild("Head") or best.PrimaryPart or best:FindFirstChildWhichIsA("BasePart", true)
	if not (det and head) then return nil end
	return { model = best, det = det, head = head }
end
local function shopTrip(pattern, doneFn)
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local item = findShopItem(pattern, root.Position)
	if not item then return false end
	local origin = root.CFrame
	local dest = CFrame.new(item.head.Position + Vector3.new(0, 1, 0))
	local t0 = os.clock()
	while not doneFn() and os.clock() - t0 < 4 and alive do
		root.CFrame = dest
		root.AssemblyLinearVelocity = Vector3.zero
		pcall(fireclickdetector, item.det)
		RunService.Heartbeat:Wait()
	end
	root.CFrame = origin
	root.AssemblyLinearVelocity = Vector3.zero
	return doneFn() == true
end
local function armorOnRespawn(char)
	if armorBusy then return end
	armorBusy = true
	task.spawn(function()
		pcall(function()
			local root = char:WaitForChild("HumanoidRootPart", 10)
			char:WaitForChild("BodyEffects", 10)
			if not root then return end
			task.wait(1)
			for _ = 1, 5 do
				if not (ArmorResp and alive and char.Parent and LP.Character == char) then break end
				local a = armorValue()
				if a and a >= maxArmor() then break end
				local done = shopTrip("[Full Armor]", function()
					local v = armorValue()
					return v ~= nil and v >= maxArmor()
				end)
				if done then break end
				task.wait(0.6)
			end
		end)
		armorBusy = false
	end)
end
connect(LP.CharacterAdded, function(char)
	if ArmorResp then armorOnRespawn(char) end
end)

