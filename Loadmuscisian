-- Arms queue_on_teleport so the script runs again in the next game. The queued code re-checks the
-- saved setting first, so turning Auto Execute off cancels an already queued run.
Reexec.queue = function()
	local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if not q then return false, "this executor has no queue_on_teleport" end
	local src = (Reexec.source or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if src == "" then return false, "no script source set" end
	-- The source can be a raw URL, a ready-made loadstring(...) line, or a file name.
	local loader
	if src:match("^https?://") then
		loader = ('loadstring(game:HttpGet(%q))()'):format(src)
	elseif src:find("loadstring", 1, true) or src:find("HttpGet", 1, true) then
		loader = src -- already code: run it as is (this used to get treated as a file name)
	else
		loader = ('loadstring(readfile(%q))()'):format(src)
	end
	local code = ('if not game:IsLoaded() then game.Loaded:Wait() end repeat task.wait() until game:GetService("Players").LocalPlayer '
		.. 'local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(%q)) end) '
		.. 'if ok and type(d) == "table" and d.auto then %s end'):format(REEXEC_FILE, loader)
	local ok = pcall(q, code)
	return ok, ok and nil or "queue_on_teleport failed"
end
