_G.AureusCleanup = function()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(RunService.UnbindFromRenderStep, RunService, unflickBind)
	if silentFlickSaved then
		local c = workspace.CurrentCamera
		if c then pcall(function() c.CFrame = silentFlickSaved end) end
		silentFlickSaved = nil
	end
	silentOn, silentSpoof, silentLastTarget = false, nil, nil
	if AV.removeTool then pcall(AV.removeTool) end
	pcall(function() if AV.folder then AV.folder:Destroy() end end)
	if PL.stopSpectate then pcall(PL.stopSpectate) end
	for _, e in pairs(espDraw) do
		for _, o in pairs(e) do pcall(function() o:Remove() end) end
	end
	pcall(function() fovGui:Destroy() end)
	pcall(function() Library:Unload() end)
end

