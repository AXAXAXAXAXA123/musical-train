	local function getGun()
		local char = LP.Character
		if not char then return nil end
		for _, tool in next, char:GetChildren() do
			if tool:IsA("Tool") and tool:FindFirstChild("Ammo") then return tool end
		end
		return nil
	end
	connect(UIS.InputBegan, function(i, gp)
		if gp or i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		if not Trig.rapid or rapidFiring then return end
		local gun = getGun()
		if not gun then return end
		rapidFiring = true
		task.spawn(function()
			while alive and rapidFiring and Trig.rapid and gun.Parent == LP.Character do
				gun:Activate()
				task.wait((Trig.rapiddelay or 10) / 1000)
			end
			rapidFiring = false
		end)
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then rapidFiring = false end
	end)
end

