-- TRIGGERBOT ENGINE
----------------------------------------------------------------
local partToEnemy = {}
local function rebuildPart(p)
	if p.Character then
		for _, v in ipairs(p.Character:GetDescendants()) do
			if v:IsA("BasePart") then partToEnemy[v] = p end
		end
	end
end
for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LP then
		rebuildPart(p)
		connect(p.CharacterAdded, function() task.wait(); rebuildPart(p) end)
	end
end
connect(Players.PlayerAdded, function(p)
	connect(p.CharacterAdded, function() task.wait(); rebuildPart(p) end)
end)
do
	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 4 then return end
		acc = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character then pcall(rebuildPart, p) end
		end
	end)
end
local trigWeaponClass
do
	local SHOTGUNS = { "[TacticalShotgun]", "[Shotgun]", "[Drum-Shotgun]", "[Double-Barrel SG]", "[Double Barrel SG]" }
	local OTHERS = { "[Revolver]", "[Silencer]", "[Glock]", "[Rifle]", "[AUG]", "[AR]", "[SMG]", "[LMG]", "[P90]", "[AK47]" }
	local cls = {}
	local function norm(n) return (n:lower():gsub("[^%w]", "")) end
	for _, n in ipairs(SHOTGUNS) do cls[norm(n)] = "shotgun" end
	for _, n in ipairs(OTHERS) do cls[norm(n)] = "smg_rev" end
	trigWeaponClass = function()
		local char = LP.Character
		if not char then return nil end
		for _, c in ipairs(char:GetChildren()) do
			if c:IsA("Tool") then
				local k = GunKind(c.Name)
				if k == "db" or k == "tac" then return "shotgun" end
				if k == "rev" or k == "smg" then return "smg_rev" end
				local got = cls[norm(c.Name)]
				if got then return got end
			end
		end
		return nil
	end
end
local function trigRange()
	if not Trig.dynrange then return Trig.maxrange end
	local w = trigWeaponClass()
	if w == "shotgun" then return Trig.shotrange end
	if w == "smg_rev" then return Trig.smgrange end
	return Trig.maxrange
end
local TRIG_GROUPS = {
	Head = { Head = true },
	Torso = { UpperTorso = true, LowerTorso = true, Torso = true, HumanoidRootPart = true },
	Arms = { LeftUpperArm = true, LeftLowerArm = true, LeftHand = true, RightUpperArm = true, RightLowerArm = true,
		RightHand = true, ["Left Arm"] = true, ["Right Arm"] = true },
	Legs = { LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true, RightUpperLeg = true, RightLowerLeg = true,
		RightFoot = true, ["Left Leg"] = true, ["Right Leg"] = true },
}
-- Is the part the crosshair hit one of the selected hit parts? Accessories count as Head unless
-- they're attached to the body (back/waist/shoulder...).
local function trigPartOk(part)
	if Trig.hitFull then return true end
	local name = part.Name
	local acc = part:FindFirstAncestorOfClass("Accessory")
	if acc then
		local att = part:FindFirstChildWhichIsA("Attachment")
		local an = att and att.Name or ""
		name = (an:find("Back") or an:find("Waist") or an:find("Shoulder") or an:find("Body") or an:find("Neck")) and "UpperTorso" or "Head"
	end
	for group in pairs(Trig.hitSet) do
		local g = TRIG_GROUPS[group]
		if g and g[name] then return true end
	end
	return false
end
-- Forcefield check with a reaction delay: blocks while they have a forcefield, and for
-- Trig.ffDelay ms after it disappears, so you don't fire the instant they become shootable.
local ffState = setmetatable({}, { __mode = "k" })
local function trigFFBlocked(p)
	if not Trig.ff then return false end
	local ch = p.Character
	if not ch then return false end
	local s = ffState[p]
	if not s then s = { had = false, goneAt = 0 }; ffState[p] = s end
	if ch:FindFirstChildOfClass("ForceField") then
		s.had = true
		return true
	end
	if s.had then
		s.had, s.goneAt = false, os.clock()
	end
	return os.clock() - s.goneAt < Trig.ffDelay / 1000
end
local function getTriggerTarget()
	local localChar = LP.Character
	local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not localRoot or not cam then return nil end

	local range = trigRange()
	local unitRay = cam:ScreenPointToRay(mouse.X, mouse.Y)
	local dir = unitRay.Direction * range
	local origin = unitRay.Origin

	for _ = 1, 5 do
		local result = workspace:Raycast(origin, dir, rayParams)
		if not result then break end
		local p = partToEnemy[result.Instance]
		if p and not plAllowed(p, "trig") then p = nil end -- blacklisted / not whitelisted: shoot through them
		if p then
			if not trigPartOk(result.Instance) then return nil end
			if Trig.dead and isDead(p) then return nil end
			if Trig.crew and sameCrew(p) then return nil end
			if trigFFBlocked(p) then return nil end
			if Trig.weapon and not trigWeaponClass() then return nil end
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - localRoot.Position).Magnitude > range then return nil end
			if Trig.wall and not visibleFrom(localRoot.Position, root, p.Character) then return nil end
			return p
		end
		local hitPos = result.Position
		dir = dir - (hitPos - origin)
		origin = hitPos + unitRay.Direction * 0.01
		if dir.Magnitude < 1 then break end
	end
	return nil
end
-- Sync with triggerbot: the silent aim target counts as a trigger target. The triggerbot's own
-- checks (dead / crew / forcefield / weapon / range / wall) still decide whether it fires.
local function getSyncedSilentTarget()
	if not Silent.syncTrig then return nil end
	local p = Silent.target
	if not p or p.Parent ~= Players then return nil end
	if not plAllowed(p, "trig") then return nil end
	local tch = p.Character
	local lroot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local root = tch and tch:FindFirstChild("HumanoidRootPart")
	if not (lroot and root) then return nil end
	if Trig.dead and isDead(p) then return nil end
	if Trig.crew and sameCrew(p) then return nil end
	if trigFFBlocked(p) then return nil end
	if Trig.weapon and not trigWeaponClass() then return nil end
	if (root.Position - lroot.Position).Magnitude > trigRange() then return nil end
	if Trig.wall and not visibleFrom(lroot.Position, root, tch) then return nil end
	return p
end
local function clickDelay()
	if Trig.dyn then
		local lo, hi = math.min(Trig.dmin, Trig.dmax), math.max(Trig.dmin, Trig.dmax)
		return math.random(lo, hi) / 1000
	end
	return Trig.delay / 1000
end
local trigFiring, trigLast, lastTgt, deadSeen = false, 0, nil, nil
connect(RunService.Heartbeat, function()
	if not TrigBind:IsActive() then trigFiring, lastTgt, deadSeen = false, nil, nil return end
	if trigFiring and os.clock() - trigLast > 1 then trigFiring = false end

	local tgt = getTriggerTarget() or getSyncedSilentTarget()
	if tgt then
		lastTgt, deadSeen = tgt, nil
	elseif lastTgt then
		local grace = Trig.afterkillOn and (Trig.afterkill / 1000) or 0
		if grace > 0 and isDead(lastTgt) then
			deadSeen = deadSeen or os.clock()
			if os.clock() - deadSeen <= grace then tgt = lastTgt else lastTgt = nil end
		else
			lastTgt, deadSeen = nil, nil
		end
	end

	if tgt and not trigFiring and (os.clock() - trigLast) > clickDelay() then
		trigFiring, trigLast = true, os.clock()
		local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
		if tool then
			task.spawn(function()
				pcall(function() tool:Activate() end)
				task.wait(math.max(clickDelay(), 0.02))
				trigFiring = false
			end)
		else
			trigFiring = false
		end
	end
end)

