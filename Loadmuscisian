local function silentPick(char, origin)
	-- "Closest" picks from every body part; HumanoidRootPart is only in the pool unless Ignore
	-- HumanoidRootPart is on (which also turns a HumanoidRootPart hit part into "Closest").
	local all = Silent.part == "Closest" or (Silent.ignoreHRP and Silent.part == "HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local best, bestD = nil, math.huge
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local ok
			if all then ok = not (Silent.ignoreHRP and part.Name == "HumanoidRootPart") else ok = silentPartMatches(part.Name) end
			if ok then
				local sp, on = cam:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
					if d < bestD then best, bestD = part, d end
				end
			end
		end
	end
	return best
end

local function silentGrabbed(char)
	local be = char:FindFirstChild("BodyEffects")
	local g = be and be:FindFirstChild("Grabbed")
	if g and g:IsA("BoolValue") and g.Value == true then return true end
	return char:FindFirstChild("GRABBING_CONSTRAINT", true) ~= nil
end

-- Current targeting radius: the FOV slider, or the smoothed dynamic radius.
local function silentRadius()
	return math.max(Silent.radius or Silent.fovSize, 1)
end
-- Dynamic FOV: the closer the nearest enemy, the bigger the radius (between Minimum and Maximum);
-- Silent.radius eases toward that goal at FOV Transition Speed.
local function silentUpdateRadius(dt)
	if not Silent.dynFov then
		Silent.radius = Silent.fovSize
		return
	end
	local lo, hi = math.min(Silent.fovMin, Silent.fovMax), math.max(Silent.fovMin, Silent.fovMax)
	local lroot = localRootPos()
	local nearest
	if lroot then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if r then
					local d = (r.Position - lroot).Magnitude
					if not nearest or d < nearest then nearest = d end
				end
			end
		end
	end
	local goal = nearest and (lo + (hi - lo) * math.clamp(1 - nearest / 300, 0, 1)) or hi
	local cur = Silent.radius or goal
	local rate = 1 + Silent.dynSpeed * 0.3
	Silent.radius = cur + (goal - cur) * (1 - math.exp(-dt * rate))
end

-- Prediction lead: where the target will be, as an offset from its current part position.
local function silentLead(p, char)
	if not Silent.pred then return Vector3.zero end
	local root = char:FindFirstChild("HumanoidRootPart")
	local vel = root and measuredVel(p, root) or Vector3.zero
	if Silent.velCheck then
		local minSpeed = (100 - Silent.velSens) * 0.2
		local speed = vel.Magnitude
		if speed < minSpeed or speed > 300 then return Vector3.zero end
	end
	local tx = Silent.predX / 100 * 0.25
	local ty = Silent.predY / 100 * 0.25
	if vel.Y > 2 then
		ty += Silent.predJump / 100 * 0.25
	elseif vel.Y < -2 then
		ty += Silent.predFall / 100 * 0.25
	end
	return Vector3.new(vel.X * tx, vel.Y * ty, vel.Z * tx)
end

-- Everything that makes a player a valid silent target, in one place: alive, target checks, in
-- range, a pickable part on screen within `radius` of the cursor, and visible if Wall check is on.
local function silentCandidate(p, mp, radius)
	if not plAllowed(p, "silent") then return nil end
	local cam = workspace.CurrentCamera
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (cam and char and hum and hum.Health > 0) then return nil end
	if Silent.deadCheck and isDead(p) then return nil end
	if Silent.grabCheck and silentGrabbed(char) then return nil end
	if Silent.ffCheck and char:FindFirstChildOfClass("ForceField") then return nil end
	if Silent.ignoreAir and hum.FloorMaterial == Enum.Material.Air then return nil end
	local troot = char:FindFirstChild("HumanoidRootPart")
	local lroot = localRootPos()
	if lroot and troot and (troot.Position - lroot).Magnitude > Silent.range then return nil end
	local part = silentPick(char, mp)
	if not part then return nil end
	local sp, on = cam:WorldToViewportPoint(part.Position)
	if not on then return nil end
	local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
	if d > radius then return nil end
	if Silent.wall and not visibleFrom(cam.CFrame.Position, part, char) then return nil end
	return part, d
end
-- Default targeting: the player whose part is closest to the mouse.
local function silentNearest(mp)
	local radius = silentRadius()
	local best, bestD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local part, d = silentCandidate(p, mp, radius)
			if part and d < bestD then best, bestD = p, d end
		end
	end
	return best
end

-- Continuous flick, ported from curzs V3's Core.flickAt: a plain CFrame.lookAt(camPos, aim) aims
-- from the camera's dead center, but this game fires along the MOUSE'S screen ray through the
-- camera. flickAt corrects for that with the cross product between the cursor's ray and the vector
-- to the target, so the camera orientation used is the one whose ray-through-the-cursor actually
-- points at the target. It runs every Heartbeat while a target is locked.
local function silentFlickAt(camPos, aim)
	local c = workspace.CurrentCamera
	if not c then return end
	if silentFlickSaved then c.CFrame = silentFlickSaved end
	local real = c.CFrame
	local base = CFrame.lookAt(camPos, aim)
	c.CFrame = base
	local mp = UIS:GetMouseLocation()
	local ray = c:ViewportPointToRay(mp.X, mp.Y).Direction.Unit
	local toTarget = (aim - camPos).Unit
	local axis = ray:Cross(toTarget)
	silentFlickSaved = real
	if axis.Magnitude >= 1e-5 then
		local angle = math.acos(math.clamp(ray:Dot(toTarget), -1, 1))
		c.CFrame = CFrame.new(camPos) * CFrame.fromAxisAngle(axis.Unit, angle) * base.Rotation
	end
end
-- Puts the real camera back at the very START of the render frame (RenderPriority.First, same as
-- curzs's BindToRenderStep(..., Core.unflick)), before the camera script reads the CFrame.
local unflickBind = "AureusUnflick"
pcall(RunService.UnbindFromRenderStep, RunService, unflickBind)
RunService:BindToRenderStep(unflickBind, Enum.RenderPriority.First.Value, function()
	if silentFlickSaved then
		local c = workspace.CurrentCamera
		if c then c.CFrame = silentFlickSaved end
		silentFlickSaved = nil
	end
end)

-- Stops silent aim cleanly (out of FOV, key released, no gun, ...). If it was active, the real
-- cursor position is sent once so the server's aim snaps back immediately.
local function silentRelease()
	local was = silentOn
	silentOn, silentSpoof, silentLastTarget = false, nil, nil
	Silent.target = nil
	if was and not SILENT_BLOCKED and holdingGun() then
		pcall(function() sendAim(mouse.Hit.Position) end)
	end
end

-- Keeps the server's mouse position pinned to the target (UpdateMos Method). curzs sends from
-- Heartbeat, Stepped, RenderStepped and the click itself, so whichever step the game's gun script
-- reads on, the value is current.
local function silentPush()
	if silentOn and silentSpoof and SilentBind:IsActive() and holdingGun() then
		local aim = Silent.force and silentReal or silentSpoof
		if aim then sendAim(aim) end
	end
end
connect(RunService.Stepped, silentPush)
connect(RunService.RenderStepped, silentPush)
connect(UIS.InputBegan, function(input, processed)
	if not processed
		and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2) then
		silentPush()
	end
end)

connect(RunService.Heartbeat, function(dt)
	-- Works the same for Toggle / Hold / Always: everything hangs off SilentBind:IsActive().
	if SILENT_BLOCKED or not SilentBind:IsActive() then
		silentRelease()
		return
	end
	-- Nothing to aim with -> no work at all (this is what keeps Always mode cheap).
	if not holdingGun() or (Silent.weapon and not trigWeaponClass()) then
		silentRelease()
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then silentRelease() return end
	local mp = UIS:GetMouseLocation()
	silentUpdateRadius(dt)
	local radius = silentRadius()

	-- The target has to be inside the FOV every tick; the moment it isn't, silent aim lets go.
	local target
	if Silent.sync then
		local lt = aimActive and lockedTarget or nil
		if lt and lt.Parent == Players and silentCandidate(lt, mp, radius) then target = lt end
	else
		local last = silentLastTarget
		if Silent.sticky and last and last.Parent == Players and silentCandidate(last, mp, radius * 1.8) then
			target = last
		end
		target = target or silentNearest(mp)
	end

	local char = target and target.Character
	local part = char and silentPick(char, mp)
	if not part then
		silentRelease()
		return
	end

	local hc = Silent.hit / 100
	local real = part.Position + silentLead(target, char)
	silentReal = real
	local now = os.clock()
	if now >= silentNextRoll then
		silentNextRoll = now + 0.3 + math.random() * 0.3
		if math.random() < (1 - hc) ^ 1.2 then
			local dir = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
			silentMissOff = (dir.Magnitude > 0 and dir.Unit or Vector3.yAxis) * (3 + math.random() * 4)
		else
			silentMissOff = Vector3.zero
		end
	end
	if Silent.force or hc >= 1 then
		silentSpoof = real
	else
		local goal = real + silentMissOff
		if silentLastTarget ~= target or not silentSpoof then
			silentSpoof = goal
		else
			silentSpoof = silentSpoof:Lerp(goal, 1 - math.exp(-dt * (2 + 38 * hc ^ 1.3)))
		end
	end
	silentLastTarget = target
	silentOn = true
	Silent.target = target

	local aim = Silent.force and silentReal or silentSpoof
	for _ = 1, Silent.force and 6 or 1 do sendAim(aim) end
	local head = LP.Character and LP.Character:FindFirstChild("Head")
	silentFlickAt(head and head.Position or cam.CFrame.Position, aim)
end)

