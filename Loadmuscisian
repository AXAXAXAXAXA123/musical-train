-- OWN BINDING SYSTEM (Toggle / Hold / Always) -- fully self-contained.
----------------------------------------------------------------
local MODES = { "Toggle", "Hold", "Always" }
local bindings = {}

local MOUSE_ALIASES = {
	mb1 = Enum.UserInputType.MouseButton1, m1 = Enum.UserInputType.MouseButton1, mousebutton1 = Enum.UserInputType.MouseButton1,
	mb2 = Enum.UserInputType.MouseButton2, m2 = Enum.UserInputType.MouseButton2, mousebutton2 = Enum.UserInputType.MouseButton2,
	mb3 = Enum.UserInputType.MouseButton3, m3 = Enum.UserInputType.MouseButton3, mousebutton3 = Enum.UserInputType.MouseButton3,
}

local function parseKey(v)
	if v == nil or type(v) == "boolean" or type(v) == "number" then return nil, false end
	if typeof(v) == "EnumItem" then
		if v.EnumType == Enum.KeyCode then
			if v == Enum.KeyCode.Unknown then return nil, true end
			return { kc = v }, false
		elseif v.EnumType == Enum.UserInputType then
			if v == Enum.UserInputType.MouseButton1 or v == Enum.UserInputType.MouseButton2 or v == Enum.UserInputType.MouseButton3 then
				return { ut = v }, false
			end
		end
		return nil, false
	end
	if type(v) == "table" then
		for _, k in ipairs({ "Key", "key", "KeyCode", "keycode", "Keycode", 1 }) do
			if v[k] ~= nil then
				local spec, clear = parseKey(v[k])
				if spec or clear then return spec, clear end
			end
		end
		return nil, false
	end
	if type(v) ~= "string" then return nil, false end
	local s = v:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^Enum%.KeyCode%.", ""):gsub("^Enum%.UserInputType%.", "")
	local low = s:lower()
	if low == "" or low == "none" or low == "nil" or low == "unbound" then return nil, true end
	if MOUSE_ALIASES[low] then return { ut = MOUSE_ALIASES[low] }, false end
	local ok, kc = pcall(function() return Enum.KeyCode[s] end)
	if ok and kc then return { kc = kc }, false end
	return nil, false
end

local function specMatches(spec, input)
	if not spec then return false end
	if spec.kc then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == spec.kc
	end
	return input.UserInputType == spec.ut
end

local function specDown(spec)
	if not spec then return false end
	if spec.kc then return UIS:IsKeyDown(spec.kc) end
	return UIS:IsMouseButtonPressed(spec.ut)
end

local function newBinding(defaultKey, defaultMode, pickerId)
	local b = {
		key = (parseKey(defaultKey)),
		mode = (defaultMode == "Hold" or defaultMode == "Always") and defaultMode or "Toggle",
		enabled = false,
		latched = true,
		picker = pickerId,
		lastSig = nil,
	}
	function b:SetKey(v)
		local spec, clear = parseKey(v)
		if spec then self.key = spec
		elseif clear then self.key = nil end
	end
	function b:SetMode(m)
		if m ~= "Toggle" and m ~= "Hold" and m ~= "Always" then return end
		self.mode = m
	end
	function b:SetEnabled(v)
		v = v == true
		if v and not self.enabled then self.latched = true end
		self.enabled = v
	end
	function b:IsActive()
		if not self.enabled then return false end
		if self.mode == "Always" or not self.key then return true end
		if self.mode == "Hold" then
			return UIS:GetFocusedTextBox() == nil and specDown(self.key)
		end
		return self.latched
	end
	table.insert(bindings, b)
	return b
end

connect(UIS.InputBegan, function(input, gp)
	if UIS:GetFocusedTextBox() then return end
	for _, b in ipairs(bindings) do
		pcall(function()
			if b.enabled and b.mode == "Toggle" and specMatches(b.key, input) then
				if b.key.ut and gp then return end
				b.latched = not b.latched
			end
		end)
	end
end)

connect(RunService.Heartbeat, function()
	for _, b in ipairs(bindings) do
		if b.picker then
			local o = Options[b.picker]
			if o and o.Value ~= nil then
				local sig = tostring(o.Value)
				if b.lastSig ~= sig then
					b.lastSig = sig
					b:SetKey(o.Value)
				end
			end
		end
	end
end)

