local function aimCanAcquire(p)
	if not p or not p.Parent or p == LP then return false end
	if not plAllowed(p, "aim") then return false end
	if Aim.crew and sameCrew(p) then return false end
	if Aim.weapon and not trigWeaponClass() then return false end
	local char = p.Character
	local hum = char and char:FindFirstChildWhichIsA("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	if Aim.dead and isDead(p) then return false end
	local troot = char and char:FindFirstChild("HumanoidRootPart")
	local lroot = localRootPos()
	if troot and lroot and (troot.Position - lroot).Magnitude > Aim.range then return false end
	return true
end
local function aimVisible(p)
	local cam = workspace.CurrentCamera
	local char = p.Character
	local part = char and (char:FindFirstChild(Aim.part) or char:FindFirstChild("HumanoidRootPart"))
	if not (cam and part) then return false end
	return visibleFrom(cam.CFrame.Position, part, char)
end
local aimActive, lockedTarget = false, nil
local function aimAcquire()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local radius = (Aim.fov / 180) * (cam.ViewportSize.X / 2)
	local best, bestD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if aimCanAcquire(p) then
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local sp, on = cam:WorldToViewportPoint(root.Position)
				if on and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if d <= radius and d < bestD and (not Aim.wall or aimVisible(p)) then
						best, bestD = p, d
					end
				end
			end
		end
	end
	return best
end

local EASE_STYLES = {
	Linear = Enum.EasingStyle.Linear, Sine = Enum.EasingStyle.Sine, Quad = Enum.EasingStyle.Quad, Cubic = Enum.EasingStyle.Cubic,
	Quart = Enum.EasingStyle.Quart, Quint = Enum.EasingStyle.Quint, Expo = Enum.EasingStyle.Exponential, Circ = Enum.EasingStyle.Circular,
}
local EASE_DIRS = { In = Enum.EasingDirection.In, Out = Enum.EasingDirection.Out, InOut = Enum.EasingDirection.InOut }
local FULL_ARC = math.rad(60)
local CONE_MIN, CONE_SPAN = 25, 30
local SPEED_MIN, SPEED_SPAN = 40, 280
local ACTIVE_SPEED = math.rad(20)
local WALK_FLOOR, WALK_MOVE = 0.55, 0.1

local function gauss(mean, sd)
	local u = math.max(math.random(), 1e-6)
	return mean + math.sqrt(-2 * math.log(u)) * math.cos(2 * math.pi * math.random()) * sd
end
local function pullFraction(sharp, farness, dt)
	if sharp >= 1 then return 1 end
	if sharp <= 0 then return 0 end
	local ok, eased = pcall(TweenService.GetValue, TweenService, math.clamp(farness, 0, 1),
		EASE_STYLES[Aim.ease] or Enum.EasingStyle.Linear, EASE_DIRS[Aim.easedir] or Enum.EasingDirection.Out)
	eased = ok and math.clamp(eased, 0, 1) or math.clamp(farness, 0, 1)
	local k = (1 - math.exp(-sharp * 55 * dt)) * (0.02 + eased * 0.98)
	return k + (1 - k) * math.clamp((sharp - 0.75) / 0.25, 0, 1)
end
local function easedProgress(t)
	local ok, eased = pcall(TweenService.GetValue, TweenService, math.clamp(t, 0, 1),
		EASE_STYLES[Aim.ease] or Enum.EasingStyle.Linear, EASE_DIRS[Aim.easedir] or Enum.EasingDirection.Out)
	return (ok and math.clamp(eased, 0, 1)) or t
end

local ad = { tgt = nil, since = 0, delay = 0, lastLook = nil, vel = 0 }
local function resetAssist() ad.tgt, ad.lastLook, ad.vel = nil, nil, 0 end

local function baseLook(cf, aimPos, dt, target)
	local pos, look = cf.Position, cf.LookVector
	local to = aimPos - pos
	if to.Magnitude < 0.05 then return nil end
	local want = to.Unit
	if Aim.aimmode == "Blatant" then return want end
	local angle = math.acos(math.clamp(look:Dot(want), -1, 1))
	local sharp = math.clamp(1 - Aim.smooth / 100, 0.01, 1)

	if not Aim.adapt then
		local k = pullFraction(sharp, angle / FULL_ARC, dt)
		if k <= 0 then return nil end
		if k >= 1 then return want end
		return look:Lerp(want, k)
	end

	local now = os.clock()
	if ad.tgt ~= target then
		ad.tgt, ad.since, ad.vel = target, now, 0
		ad.delay = math.clamp(gauss(0.09, 0.015), 0.05, 0.13)
	end
	local myTurn = 0
	if ad.lastLook then myTurn = math.acos(math.clamp(look:Dot(ad.lastLook), -1, 1)) / dt end
	ad.lastLook = look
	if now - ad.since < ad.delay then return nil end

	local cone = math.rad(CONE_MIN + CONE_SPAN * sharp)
	if angle > cone then return nil end
	local prox = 1 - angle / cone
	local weight = prox * prox * (3 - 2 * prox)

	local active = math.clamp(myTurn / ACTIVE_SPEED, 0, 1)
	local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.MoveDirection.Magnitude > WALK_MOVE and active < WALK_FLOOR then active = WALK_FLOOR end

	local base = 0.35 + 0.45 * sharp
	local step = angle * (1 - math.exp(-(6 + 18 * sharp) * weight * (base + (1 - base) * active) * dt))
	local cap = math.rad(SPEED_MIN + SPEED_SPAN * sharp) * dt
	ad.vel = ad.vel * 0.55 + math.min(step, cap) * 0.45
	if angle < 1e-4 then return nil end
	return look:Lerp(want, math.clamp(ad.vel / angle, 0, 1))
end

-- Sticky aim (legit): once the view has settled on the target, it can't drift further than a small
-- hold cone away from them. The pull itself (baseLook) is untouched, so smoothness and easing
-- stay exactly as configured; this only limits how far you can be pulled off.
local stick = { tgt = nil, engaged = false }
-- Velocity Delay output (set each frame by vdUpdate): vdGain scales the VERTICAL pull only.
local vdGain, vdGainH, vdActive = 1, 1, false -- vertical / horizontal pull scale
local function ypOf(v) return math.atan2(-v.X, -v.Z), math.asin(math.clamp(v.Y, -1, 1)) end
local function nextLook(cf, aimPos, dt, target)
	local look = baseLook(cf, aimPos, dt, target)
	if vdActive and look then
		-- keep the direction the pull wanted but only move a fraction of the way on each axis:
		-- the aim can only ever pull LESS (yaw by vdGainH, pitch by vdGain), never push anywhere,
		-- so it can't fight your mouse
		local cy, cp = ypOf(cf.LookVector)
		local ry, rp = ypOf(look)
		local dy = (ry - cy + math.pi) % (2 * math.pi) - math.pi
		local ny = cy + dy * vdGainH
		local np = cp + (rp - cp) * vdGain
		look = Vector3.new(-math.sin(ny) * math.cos(np), math.sin(np), -math.cos(ny) * math.cos(np))
	end
	if vdActive or not Aim.sticky or Aim.aimmode == "Blatant" then return look end
	local to = aimPos - cf.Position
	if to.Magnitude < 0.05 then return look end
	local want = to.Unit
	if stick.tgt ~= target then stick.tgt, stick.engaged = target, false end
	local res = look or cf.LookVector
	local angle = math.acos(math.clamp(res:Dot(want), -1, 1))
	local hold = math.rad(1.5 + Aim.smooth / 100 * 2.5)
	if not stick.engaged then
		if angle <= hold * 2 then stick.engaged = true end
		return look
	end
	if angle > hold then
		return want:Lerp(res, hold / angle).Unit
	end
	return look
end

local closestFor, closestName = nil, nil
local BODY_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
	"Left Arm", "Right Arm", "Left Leg", "Right Leg",
}
local function closestPart(char, cam, target)
	if closestFor ~= target then closestFor, closestName = target, nil end
	local vs = cam.ViewportSize
	local center = Vector2.new(vs.X / 2, vs.Y / 2)
	local radius = (Aim.fov / 180) * (vs.X / 2)
	local nearName, nearD, inName, inD, curD = nil, math.huge, nil, math.huge, nil
	for _, name in ipairs(BODY_PARTS) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local sp, on = cam:WorldToViewportPoint(p.Position)
			if on then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if name == closestName then curD = d end
				if d < nearD then nearD, nearName = d, name end
				if d <= radius and d < inD then inD, inName = d, name end
			end
		end
	end
	local pick, pd = inName or nearName, inName and inD or nearD
	if pick and closestName and closestName ~= pick and curD and curD <= pd + 12 and (curD <= radius or not inName) then
		pick = closestName
	end
	closestName = pick
	return pick and char:FindFirstChild(pick) or nil
end
local function pickAimPart(char, mode, cam, target)
	local root = char:FindFirstChild("HumanoidRootPart")
	if mode == "Closest part" then return closestPart(char, cam, target) or root end
	if mode == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root end
	return char:FindFirstChild(mode) or root
end

local MOUSE_REL = (typeof(mousemoverel) == "function" and mousemoverel) or nil
local function mouseAssist(cam, cf, aimPos, dt, target)
	local inset = GuiService:GetGuiInset()
	local cur = UIS:GetMouseLocation() - inset
	local destX, destY, k
	if Aim.aimmode == "Blatant" then
		local tp = cam:WorldToScreenPoint(aimPos)
		if tp.Z <= 0 then return end
		destX, destY, k = tp.X, tp.Y, 1
	elseif Aim.adapt then
		local look = nextLook(cf, aimPos, dt, target)
		if not look or look.Magnitude < 1e-4 then return end
		local sp, vis = cam:WorldToScreenPoint(cf.Position + look.Unit * 100)
		if not vis or sp.Z <= 0 then return end
		destX, destY, k = sp.X, sp.Y, 1
	else
		local tp = cam:WorldToScreenPoint(aimPos)
		if tp.Z <= 0 then return end
		local dx, dy = tp.X - cur.X, tp.Y - cur.Y
		local dist = math.sqrt(dx * dx + dy * dy)
		local holdPx = 6 + Aim.smooth / 100 * 10
		if Aim.sticky then
			if stick.tgt ~= target then stick.tgt, stick.engaged = target, false end
			if not stick.engaged and dist <= holdPx * 2 then stick.engaged = true end
		end
		if Aim.sticky and stick.engaged and dist > holdPx then
			destX, destY, k = tp.X - dx / dist * holdPx, tp.Y - dy / dist * holdPx, 1
		else
			if dist < 2 then return end
			k = pullFraction(math.clamp(1 - Aim.smooth / 100, 0.01, 1), math.clamp(dist / 400, 0, 1), dt)
			if k <= 0 then return end
			destX, destY = tp.X, tp.Y
		end
	end
	local mx, my = (destX - cur.X) * k, (destY - cur.Y) * k
	if vdActive and not Aim.adapt and Aim.aimmode ~= "Blatant" then mx, my = mx * vdGainH, my * vdGain end
	if MOUSE_REL then
		MOUSE_REL(mx, my)
	else
		VIM:SendMouseMoveEvent(cur.X + mx + inset.X, cur.Y + my + inset.Y, game)
	end
end

