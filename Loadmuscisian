			local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
			if cam and hum then cam.CameraSubject = hum end
		end
		setT("pl_spec", false)
	end
	PL.stopSpectate = stopSpectate
	rightBox:AddToggle("pl_spec", { Text = "Spectate Target", Default = false,
		Tooltip = "Your camera follows this player until you turn it off.",
		Callback = function(v)
			if loading then return end
			if v then
				if not PL.selected then setT("pl_spec", false) return end
				spec.target = PL.selected
			elseif spec.target then
				stopSpectate()
			end
		end })
	connect(RunService.RenderStepped, function()
		local sp = spec.target
		if not sp then return end
		if sp.Parent ~= Players then stopSpectate() return end -- they left
		local hum = sp.Character and sp.Character:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera
		if hum and cam and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
	end)

	----------------------------------------------------------------
	-- PERM SETTINGS: Perm Whitelist / Perm Blacklist (by username or UserId, saved to a file)
	----------------------------------------------------------------
	pcall(function() rightBox:AddDivider() end)
	rightBox:AddLabel("Perm Settings")
	local permBox = PlayerTab:AddRightTabbox()
	local permLists = {}

	local function makeList(parent, height)
		local w = Instance.new("Frame")
		w.Size = UDim2.new(1, -4, 0, height)
		w.BackgroundColor3 = Library.MainColor
		w.BorderColor3 = Library.OutlineColor
		w.ZIndex = 5
		w.Parent = parent
		themed(w, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
		local sf = Instance.new("ScrollingFrame")
		sf.Position, sf.Size = UDim2.fromOffset(1, 1), UDim2.new(1, -2, 1, -2)
		sf.BackgroundTransparency = 1
		sf.BorderSizePixel = 0
		sf.ScrollBarThickness = 3
		sf.ScrollBarImageColor3 = Library.AccentColor
		themed(sf, { ScrollBarImageColor3 = "AccentColor" })
		sf.CanvasSize = UDim2.new()
		sf.ZIndex = 6
		sf.Parent = w
		local pd = Instance.new("UIPadding")
		pd.PaddingTop, pd.PaddingLeft, pd.PaddingRight = UDim.new(0, 2), UDim.new(0, 2), UDim.new(0, 4)
		pd.Parent = sf
		local ly = Instance.new("UIListLayout")
		ly.SortOrder = Enum.SortOrder.LayoutOrder
		ly.Padding = UDim.new(0, 0)
		ly.Parent = sf
		ly:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			sf.CanvasSize = UDim2.fromOffset(0, ly.AbsoluteContentSize.Y + 4)
		end)
		return w, sf
	end

	local permRows
	permRows = function(kind)
		local ui = permLists[kind]
		if not ui then return end
		for _, ch in ipairs(ui.list:GetChildren()) do
			if ch:IsA("Frame") then ch:Destroy() end
		end
		local ids = {}
		for uid in pairs(PL.perm[kind]) do ids[#ids + 1] = uid end
		local function nm(uid)
			local i = PL.permInfo[uid]
			return ((i and i.display) or tostring(uid)):lower()
		end
		table.sort(ids, function(a, b) return nm(a) < nm(b) end)
		for i, uid in ipairs(ids) do
			local live = Players:GetPlayerByUserId(uid)
			if live then PL.permInfo[uid] = { name = live.Name, display = live.DisplayName } end
			local info = PL.permInfo[uid]
			if not info then -- saved without names: look them up once, then redraw
				PL.permInfo[uid] = { name = tostring(uid), display = tostring(uid) }
				task.spawn(function()
					local ok, infos = pcall(function() return Players:GetUserInfosByUserIdsAsync({ uid }) end)
					if ok and infos and infos[1] and PL.perm[kind][uid] then
						PL.permInfo[uid] = { name = infos[1].Username, display = infos[1].DisplayName }
						permRows(kind)
					end
				end)
				info = PL.permInfo[uid]
			end
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 34)
			row.BackgroundTransparency = 1
			row.BorderSizePixel = 0
			row.ZIndex = 7
			row.LayoutOrder = i
			row.Parent = ui.list
			local av = Instance.new("ImageLabel")
			av.Position, av.Size = UDim2.fromOffset(3, 3), UDim2.fromOffset(28, 28)
			av.BackgroundColor3 = Library.BackgroundColor
			av.BorderColor3 = Library.OutlineColor
			av.Image = string.format(THUMB, uid)
			av.ZIndex = 8
			av.Parent = row
			themed(av, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" })
			mkText(row, UDim2.fromOffset(37, 2), UDim2.new(1, -68, 0, 16), 13, false).Text = info.display
			mkText(row, UDim2.fromOffset(37, 18), UDim2.new(1, -68, 0, 13), 11, true).Text = "@" .. info.name
			local x = Instance.new("TextButton")
			x.Position, x.Size = UDim2.new(1, -26, 0, 5), UDim2.fromOffset(22, 24)
			x.BackgroundTransparency = 1
			x.BorderSizePixel = 0
			x.AutoButtonColor = false
			x.Font = font
			x.TextSize = 16
			x.Text = "X"
			x.TextColor3 = Color3.new(1, 1, 1) -- white X
			x.ZIndex = 8
			x.Parent = row
			x.MouseButton1Click:Connect(function() permRemove(kind, uid) end)
		end
	end
	PL.permChanged = function()
		permRows("white")
		permRows("black")
		for p in pairs(entries) do refreshEntry(p) end
	end

	-- resolve a username or UserId, then add it to the list
	local function addPerm(kind, text)
		text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		task.spawn(function()
			local uid
			if text:match("^%d+$") then
				uid = tonumber(text)
			else
				local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
				if ok then uid = id end
			end
			if not uid then notify("Couldn't find that user") return end
			if uid == LP.UserId then notify("That's you") return end
			local name, display
			local live = Players:GetPlayerByUserId(uid)
			if live then
				name, display = live.Name, live.DisplayName
			else
				local ok, infos = pcall(function() return Players:GetUserInfosByUserIdsAsync({ uid }) end)
				if ok and infos and infos[1] then
					name, display = infos[1].Username, infos[1].DisplayName
				else
					local ok2, n = pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
					if not ok2 then notify("Couldn't find that user") return end
					name, display = n, n
				end
			end
			permAdd(kind, uid, name, display)
		end)
	end

	for _, kind in ipairs({ "white", "black" }) do
		local tab = permBox:AddTab(kind == "white" and "Perm Whitelist" or "Perm Blacklist")
		local id = "pl_perm_" .. kind
		-- not "Finished": that only updates .Value on Enter, which is why Add used to do nothing
		tab:AddInput(id, { Text = "Username or UserId", Default = "", Placeholder = "name or id, then Add / Enter" })
		tab:AddButton({ Text = "Add", Func = function()
			local o = Options[id]
			if o and o.Value and o.Value ~= "" then
				addPerm(kind, o.Value)
				pcall(function() o:SetValue("") end)
			end
		end })
		local _, sf = makeList(tab.Container, 150)
		permLists[kind] = { list = sf }
		pcall(function() tab:Resize() end)
		permRows(kind)
	end
	-- Enter adds too: if the focused box holds exactly what one of the inputs holds, add it
	connect(UIS.InputBegan, function(input)
		if input.KeyCode ~= Enum.KeyCode.Return and input.KeyCode ~= Enum.KeyCode.KeypadEnter then return end
		local fb = UIS:GetFocusedTextBox()
		if not fb or fb.Text == "" then return end
		for _, kind in ipairs({ "white", "black" }) do
			local o = Options["pl_perm_" .. kind]
			if o and o.Value == fb.Text then
				addPerm(kind, fb.Text)
				pcall(function() o:SetValue("") end)
				return
			end
		end
	end)

	-- load a player's saved settings into the toggles
	local function loadSaved(p)
		local c = p and PL.cfg[p.UserId]
		loading = true
		local function S(id, v)
			local tg = Toggles[id]
			if tg then pcall(function() tg:SetValue(v == true) end) end
		end
		S("pl_black", c and c.black)
		S("pl_white", c and c.white)
		S("pl_view", c and c.view)
		S("pl_spec", p ~= nil and spec.target == p)
		for _, f in ipairs(PL_FEATURES) do
			S("pl_bl_" .. f.key, c and c.bl[f.key])
			S("pl_wl_" .. f.key, c and c.wl[f.key])
		end
		loading = false
	end
	local function selectPlayer(p)
		PL.selected = p
		loadSaved(p)
		updateHeader(p)
		for q in pairs(entries) do refreshEntry(q) end
	end

	----------------------------------------------------------------
	-- list entries (one per player, no duplicates, kept in name order)
	----------------------------------------------------------------
	local function reorder()
		local ps = {}
		for p in pairs(entries) do ps[#ps + 1] = p end
		table.sort(ps, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
		for i, p in ipairs(ps) do entries[p].btn.LayoutOrder = i end
	end
	local function addEntry(p)
		if p == LP or entries[p] then return end
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 34)
		btn.BackgroundColor3 = Library.AccentColor
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.ZIndex = 7
		btn.Parent = list
		local av = Instance.new("ImageLabel")
		av.Position, av.Size = UDim2.fromOffset(3, 3), UDim2.fromOffset(28, 28)
		av.BackgroundColor3 = Library.BackgroundColor
		av.BorderColor3 = Library.OutlineColor
		av.Image = string.format(THUMB, p.UserId)
		av.ZIndex = 8
		av.Parent = btn
		themed(av, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" })
		mkText(btn, UDim2.fromOffset(37, 2), UDim2.new(1, -78, 0, 16), 13, false).Text = p.DisplayName
		mkText(btn, UDim2.fromOffset(37, 18), UDim2.new(1, -78, 0, 13), 11, true).Text = "@" .. p.Name
		local st = mkText(btn, UDim2.new(1, -40, 0, 2), UDim2.fromOffset(36, 30), 10, true)
		st.TextXAlignment = Enum.TextXAlignment.Right
		entries[p] = { btn = btn, status = st }
		btn.MouseButton1Click:Connect(function() selectPlayer(p) end)
		local c = PL.cfg[p.UserId]
		if c and c.view then AV.pl[p] = true end -- came back: Aimview setting is still there
		refreshEntry(p)
		reorder()
		plRecount()
	end
	local function removeEntry(p)
		local e = entries[p]
		if e then
			entries[p] = nil
			pcall(function() e.btn:Destroy() end)
		end
		AV.pl[p] = nil
		if PL.selected == p then selectPlayer(nil) end
		reorder()
		task.delay(0.3, plRecount) -- once they're really gone from Players
	end

	updateHeader(nil)
	for _, p in ipairs(Players:GetPlayers()) do addEntry(p) end
	connect(Players.PlayerAdded, addEntry)
	connect(Players.PlayerRemoving, removeEntry)

	pcall(function() leftBox:Resize() end)
	pcall(function() rightBox:Resize() end)
end)

