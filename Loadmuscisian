-- ====================  MISC: ZHD (Auto Quickreset)  ============
----------------------------------------------------------------
-- Only exists in PlaceId 138014591158268. Fires QuickResetRequest as soon as you're down
-- (BodyEffects.Dead), after the delay, unless you're in a ranked match / battle royale or a
-- quick reset is already running.
if game.PlaceId == 138014591158268 then
	local AQR = { on = false, delay = 0, busy = false }
	local function aqrCharacter()
		local ch = LP.Character
		if not ch then return nil end
		local be = ch:FindFirstChild("BodyEffects")
		local dead = be and be:FindFirstChild("Dead")
		if not dead or not dead.Value then return nil end
		if ch:GetAttribute("RankedMatch") then return nil end
		local br = RS:FindFirstChild("BattleRoyale")
		if br then
			local ok, v = pcall(function() return br.Value end)
			if ok and v then return nil end
		end
		return ch
	end
	task.spawn(function()
		while alive do
			task.wait(0.05)
			if not AQR.on or AQR.busy then continue end
			local ch = aqrCharacter()
			if not ch or ch:GetAttribute("QuickResetAt") then continue end
			AQR.busy = true
			task.wait(AQR.delay / 1000)
			if alive and AQR.on and aqrCharacter() == ch and not ch:GetAttribute("QuickResetAt") then
				local remote = RS:FindFirstChild("QuickResetRequest")
				if remote then pcall(function() remote:FireServer() end) end
			end
			AQR.busy = false
		end
	end)
	build("ZHD", function()
		local sec = MiscTab:AddRightGroupbox("ZHD")
		sec:AddToggle("aqr_enabled", { Text = "Auto Quickreset", Default = false,
			Tooltip = "Resets you the second you go down so you don't sit there waiting.",
			Callback = function(v) AQR.on = v end })
		sec:AddSlider("aqr_delay", { Text = "Delay", Default = 0, Min = 0, Max = 2000, Rounding = 0, Suffix = "ms",
			Tooltip = "How long it waits before resetting.",
			Callback = function(v) AQR.delay = math.clamp(v, 0, 2000) end })
	end)
end

