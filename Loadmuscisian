local AV = {
	all = false, list = false, tool = false, self = false,
	color = GOLD, thick = 0.15, dist = 1000, marker = false,
	sel = {},
	pl = {}, -- players with Aimview forced on from the Player List
}
-- (scoped in a do-block: keeps the main chunk under Lua's 200-local limit)
do
local avFolder = Instance.new("Folder")
avFolder.Name = "AureusAimview"
avFolder.Parent = workspace
local avParams = RaycastParams.new()
avParams.FilterType = Enum.RaycastFilterType.Exclude
local avViews = {}

local function avMakePart(ball)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if ball then part.Shape = Enum.PartType.Ball end
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	return part
end
local function avGet(p)
	local v = avViews[p]
	if not v then
		v = { line = avMakePart(false), dot = avMakePart(true) }
		avViews[p] = v
	end
	return v
end
local function avHide(v)
	v.line.Parent = nil
	v.dot.Parent = nil
end
local function avOrigin(char)
	local tool = char:FindFirstChildOfClass("Tool")
	local handle = tool and tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then return handle.Position end
	local head = char:FindFirstChild("Head")
	if head then return head.Position end
	local root = char:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end
local function avAimPoint(p, char, origin, cam)
	if p == LP then
		local m = UIS:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		avParams.FilterDescendantsInstances = { char, avFolder }
		local res = workspace:Raycast(ray.Origin, ray.Direction * AV.dist, avParams)
		return res and res.Position or (ray.Origin + ray.Direction * AV.dist)
	end
	local be = char:FindFirstChild("BodyEffects")
	local mp = be and be:FindFirstChild("MousePos")
	if mp and mp:IsA("Vector3Value") and mp.Value ~= Vector3.zero then return mp.Value end
	local head = char:FindFirstChild("Head")
	if head then return origin + head.CFrame.LookVector * 100 end
	return nil
end
local function avDraw(p, cam)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum and hum.Health > 0) then return false end
	local origin = avOrigin(char)
	if not origin then return false end
	local aim = avAimPoint(p, char, origin, cam)
	if not aim then return false end
	local dir = aim - origin
	if dir.Magnitude < 0.01 then return false end
	dir = dir.Unit * AV.dist

	avParams.FilterDescendantsInstances = { char, avFolder }
	local res = workspace:Raycast(origin, dir, avParams)
	local endp = res and res.Position or (origin + dir)
	local len = (endp - origin).Magnitude
	if len < 0.05 then return false end

	local v = avGet(p)
	v.line.Color = AV.color
	v.line.Size = Vector3.new(AV.thick, AV.thick, len)
	v.line.CFrame = CFrame.lookAt(origin, endp) * CFrame.new(0, 0, -len / 2)
	v.line.Parent = avFolder

	if AV.marker and res then
		v.dot.Color = AV.color
		v.dot.Size = Vector3.one * math.max(AV.thick * 3.5, 0.5)
		v.dot.Position = endp
		v.dot.Parent = avFolder
	else
		v.dot.Parent = nil
	end
	return true
end
